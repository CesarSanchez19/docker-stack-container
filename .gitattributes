# Configuración de fin de línea unificada (LF en todo el stack)
* text=auto eol=lf

# Forzar line endings LF en scripts y configs montados en contenedores Linux
*.sh text eol=lf
*.js text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
.env* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

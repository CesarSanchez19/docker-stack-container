# Credenciales unificadas de administrador
ADMIN_USER=nombre_usuario_admin
ADMIN_PASSWORD=contraseña_segura

# pgAdmin — correo de acceso a la interfaz web
PGADMIN_EMAIL=correo@dominio.com

# PostgreSQL — nombre de la base de datos inicial
POSTGRES_DB=name_db_postgresql

# Puertos Expuestos (Host)
POSTGRES_PORT=0000
MYSQL_PORT=0000
MONGO_PORT=0000
PGADMIN_PORT=0000